{
  "id": "deepseek",
  "name": "DeepSeek Chat",
  "baseUrl": "https://chat.deepseek.com/",
  "enabled": true,
  "selectors": {
    "chatInput": "textarea[placeholder], div[contenteditable=\"true\"], textarea",
    "sendButton": "button[type=\"submit\"], button[data-testid=\"send-button\"]",
    "stopButton": "button[data-testid=\"stop-button\"]",
    "assistantMessage": "[data-testid=\"assistant-message\"], .markdown-body, [class*=\"message\"][class*=\"assistant\"]"
  },
  "completionRules": {
    "waitForStopButtonDisappear": true,
    "maxWaitMs": 120000
  },
  "_controlsNote": "DeepSeek has no model dropdown. Two modes and two inline toggles, all reporting their own state. Smart Search exists only under Instant.",
  "controls": [
    {
      "id": "mode",
      "label": "Mode",
      "kind": "select",
      "default": "default",
      "options": [
        { "value": "default", "label": "Instant" },
        { "value": "expert", "label": "Advanced" }
      ]
    },
    { "id": "deep-thinking", "label": "Deep thinking", "kind": "toggle", "default": true },
    { "id": "smart-search", "label": "Smart Search", "kind": "toggle", "default": false }
  ],
  "controlSelectors": {
    "modeOption": "[role=\"radiogroup\"] [data-model-type=\"{value}\"]",
    "toggle": ".ds-toggle-button",
    "deepThinkingText": "Deep thinking",
    "smartSearchText": "Smart Search"
  },
  "profileDir": "local-agent/storage/browser-profiles/deepseek"
}
