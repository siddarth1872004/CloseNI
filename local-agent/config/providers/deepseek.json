{
  "id": "deepseek",
  "name": "DeepSeek Chat",
  "baseUrl": "https://chat.deepseek.com/",
  "enabled": true,
  "selectors": {
    "chatInput": "textarea[placeholder], div[contenteditable=\"true\"], textarea",
    "sendButton": "button[type=\"submit\"], button[data-testid=\"send-button\"]",
    "stopButton": "button[data-testid=\"stop-button\"]",
    "assistantMessage": "[data-testid=\"assistant-message\"], .markdown-body, [class*=\"message\"][class*=\"assistant\"]"
  },
  "completionRules": {
    "waitForStopButtonDisappear": true,
    "maxWaitMs": 120000
  },
  "profileDir": "local-agent/storage/browser-profiles/deepseek"
}
