{
  "id": "glm",
  "name": "GLM (Z.ai)",
  "baseUrl": "https://chat.z.ai/",
  "enabled": true,
  "_selectorsUnverified": "These selectors have never been checked against the live site. If GLM hangs or sends nothing, correct chatInput and sendButton here first - it is a text edit, not a code change.",
  "selectors": {
    "chatInput": "textarea, div[contenteditable=\"true\"]",
    "sendButton": "button[type=\"submit\"], button[class*=\"send\"]",
    "stopButton": "button[class*=\"stop\"]",
    "assistantMessage": "[class*=\"assistant\"], .markdown-body, [class*=\"message\"][class*=\"bot\"]"
  },
  "completionRules": {
    "waitForStopButtonDisappear": true,
    "maxWaitMs": 120000
  },
  "_controlsNote": "Radix UI. Options carry data-value and data-selected. The casing of data-value is inconsistent in GLM's own markup - copy these values verbatim, do not derive them from the labels. Search / Advanced Search is not wired: its trigger was not captured.",
  "controls": [
    {
      "id": "model",
      "label": "Model",
      "kind": "select",
      "default": "glm-5.2",
      "options": [
        { "value": "glm-5.2", "label": "GLM-5.2" },
        { "value": "GLM-5.1", "label": "GLM-5.1" },
        { "value": "GLM-5-Turbo", "label": "GLM-5-Turbo" },
        { "value": "GLM-5v-Turbo", "label": "GLM-5V-Turbo" },
        { "value": "glm-4.7", "label": "GLM-4.7" }
      ]
    },
    {
      "id": "thinking",
      "label": "Deep Think",
      "kind": "select",
      "default": "Max",
      "options": [
        { "value": "High", "label": "High" },
        { "value": "Max", "label": "Max" }
      ]
    }
  ],
  "controlSelectors": {
    "modelTrigger": "button[aria-label=\"Select a model\"]",
    "modelOption": "[aria-label=\"model-item\"][data-value=\"{value}\"]",
    "thinkingTrigger": "[data-dropdown-menu-trigger]",
    "thinkingTriggerText": "Deep Think",
    "thinkingOption": "[data-selected]"
  },
  "profileDir": "local-agent/storage/browser-profiles/glm"
}
