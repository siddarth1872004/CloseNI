{
  "name": "agentic-web-coder",
  "displayName": "Agentic Web Coder",
  "description": "Ask DeepSeek/Qwen via browser and apply code patches safely",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentic-web-coder.askAI",
        "title": "Agentic Coder: Ask AI & Apply Patch"
      }
    ],
    "configuration": {
      "title": "Agentic Web Coder",
      "properties": {
        "agenticWebCoder.provider": {
          "type": "string",
          "default": "deepseek",
          "enum": [
            "deepseek",
            "qwen-studio"
          ],
          "description": "The AI provider to use"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json"
  },
  "dependencies": {
    "@agentic/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.4"
  }
}