{
  "name": "closeni",
  "productName": "CloseNI",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop agent that drives web-based AI chats through a real browser to plan, build and verify software projects. No API keys.",
  "license": "MIT",
  "author": "Siddarth S",
  "homepage": "https://siddarth1872004.github.io/CloseNI/",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddarth1872004/CloseNI.git"
  },
  "keywords": [
    "ai",
    "agent",
    "electron",
    "playwright",
    "code-generation",
    "desktop"
  ],
  "main": "desktop/main.js",
  "workspaces": [
    "shared",
    "local-agent",
    "vscode-extension",
    "desktop"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "verify": "node scripts/verify.mjs",
    "verify:visual": "node scripts/verify-visual.mjs",
    "test": "node local-agent/test/run-tests.cjs",
    "test:e2e": "node local-agent/test/run-e2e.cjs",
    "assets": "node scripts/make-svg-assets.mjs && node scripts/make-screenshots.mjs",
    "trial": "node scripts/trial-build.mjs",
    "edge": "node scripts/edge-cases.mjs",
    "verify:all": "npm run verify && npm run edge && npm test",
    "smoke": "node local-agent/dist/index.js smoke",
    "headless": "node bin/closeni.js",
    "mcp:interop": "node scripts/mcp-interop.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "com.siddarth.closeni",
    "productName": "CloseNI",
    "icon": "build/icon.png",
    "files": [
      "package.json",
      "desktop/**/*",
      "local-agent/dist/**/*",
      "local-agent/config/**/*",
      "build/icon.png",
      "bin/**/*"
    ],
    "asarUnpack": [
      "local-agent/**",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Siddarth S <sid1872004@gmail.com>",
      "synopsis": "Drive web AI chats as a build pipeline",
      "description": "A desktop agent that drives web-based AI chats through a real browser to plan, build and verify software projects. No API keys."
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  },
  "bin": {
    "closeni": "bin/closeni.js"
  }
}
